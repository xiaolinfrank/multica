# BayClaw HTTPS/HTTP2 前置代理
#
# 目的：浏览器对同一 origin 的 HTTP/1.1 并发连接上限是 6 条。BayClaw 的登录态
# 页面常驻若干轮询请求（/api/chat/pending-tasks 等）会占住槽位，一旦占满，后
# 续的 JS chunk 与数据 API 全部在浏览器本地排队（DevTools 表现为 pending +
# "Provisional headers are shown"），页面就"卡住"、agent 名解析不出而显示
# Unknown Agent。HTTP/2 多路复用把这个上限彻底消除：一条 TCP 连接跑任意多请求。
#
# 端口布局（用户地址不变，仍是 13000，只是协议从 http 变 https）：
#   :13000  Caddy HTTPS/HTTP2      <- 用户访问入口
#   :13001  Next.js（仅 127.0.0.1）<- 内部上游，同时充当应急后门
#   :18080  Go API（Next.js 自己代理过去）
#
# 证书：内网 IP 无法由 Let's Encrypt 签发，使用 Caddy 的内部 CA 自签名证书
# （tls internal）。用户首次访问会看到浏览器安全警告，点"高级 → 继续前往"即可。
#
# 启动：由 launchd 托管（~/Library/LaunchAgents/com.bayclaw.caddy.plist）
# 访问：https://10.35.178.181:13000  /  https://10.35.182.19:13000
# 应急：若 HTTPS 出问题，SSH 到本机用 http://127.0.0.1:13001 直连 Next.js
{
	# 关掉管理端口，避免与其它本地服务抢占；也不需要热更新 API。
	admin off
	# 自签名证书由 Caddy 内部 CA 签发，有效期短、自动续期。
	local_certs

	# 同一端口上嗅探协议：明文 HTTP 请求（旧 http:// 书签）308 跳转到 https，
	# TLS 连接正常走 HTTPS/HTTP2。http_redirect 必须在 tls 之前。
	servers :13000 {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

# 两块网卡的地址都监听，用户从哪个网段来都能访问。
# 明文 http:// 请求会被 Caddy 自动 308 跳转到 https://（同端口）。
https://10.35.178.181:13000, https://10.35.182.19:13000, https://localhost:13000, https://fosun-main-agentdeMac-mini.local:13000 {
	tls internal

	# 反代到 Next.js 生产服务（已挪到 13001，仅监听回环）。
	reverse_proxy 127.0.0.1:13001 {
		# WebSocket 与 SSE 需要原样透传（BayClaw 的实时通道走 /ws）。
		# Caddy 默认已支持 Upgrade；X-Forwarded-Host / -Proto 也默认透传。
		header_up Host {upstream_hostport}
		header_up X-Real-IP {remote_host}

		# 轮询/长连接不设短超时，否则实时通道会被周期性掐断。
		transport http {
			read_timeout 0
			write_timeout 0
			dial_timeout 10s
		}
	}

	# 访问日志单独落盘，便于排查（自动轮转，不会像 server.log 那样长到 GB 级）。
	log {
		output file /Users/fosun_main_agent/var/multica/logs/caddy-access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format console
	}
}
